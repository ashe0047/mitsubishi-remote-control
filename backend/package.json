{
  "name": "smart-home-app-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:dev:env": "NODE_ENV=development nest start --watch",
    "start:prod:env": "NODE_ENV=production node dist/main",
    "start:test": "NODE_ENV=test nest start",
    "start:staging": "NODE_ENV=staging nest start",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:cov": "NODE_ENV=test jest --coverage",
    "test:debug": "NODE_ENV=test node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.json",
    "build:dev": "NODE_ENV=development nest build",
    "build:prod": "NODE_ENV=production nest build",
    "build:test": "NODE_ENV=test nest build",
    "typeorm": "typeorm-ts-node-commonjs --pretty",
    "db:migrate": "typeorm-ts-node-commonjs  migration:run -d ./src/database/data-source.ts",
    "db:migrate:generate": "typeorm-ts-node-commonjs  migration:generate --pretty -d ./src/database/data-source.ts migrations/$npm_config_name-migration",
    "db:migrate:create": "npm run typeorm migration:create --",
    "db:migrate:revert": "npm run typeorm migration:revert -- -d ./src/database/data-source.ts",
    "db:migrate:show": "npm run typeorm migration:show -- -d ./src/database/data-source.ts",
    "db:migrate:drop": "npm run typeorm schema:drop -- -d ./src/database/data-source.ts",
    "db:migrate:sync": "npm run typeorm schema:sync -- -d ./src/database/data-source.ts"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.3",
