    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.8",
    "@nestjs/platform-ws": "^11.1.8",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.8",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt-ts": "^7.1.0",
    "cache-manager": "^7.2.4",
